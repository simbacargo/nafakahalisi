{
  "pages": {
    "/not-found": [
      "static/chunks/webpack.js",
      "static/chunks/main-app.js",
      "static/chunks/app/not-found.js"
    ],
    "/(sw)/layout": [
      "static/chunks/webpack.js",
      "static/chunks/main-app.js",
      "static/css/app/(sw)/layout.css",
      "static/chunks/app/(sw)/layout.js"
    ],
    "/(sw)/page": [
      "static/chunks/webpack.js",
      "static/chunks/main-app.js",
      "static/chunks/app/(sw)/page.js"
    ]
  }
}